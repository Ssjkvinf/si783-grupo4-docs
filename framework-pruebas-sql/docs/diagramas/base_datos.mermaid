%% GENERADO por scripts/docs/gen_docs.py. No editar a mano.
%% Base INTERNA (SQLite): metadatos e historial. No incluye la base Oracle objetivo.
erDiagram
    projects {
        INTEGER id PK
        VARCHAR name
        VARCHAR description
        DATETIME created_at
        DATETIME updated_at
    }
    connection_profiles {
        INTEGER id PK
        INTEGER project_id FK
        VARCHAR name
        VARCHAR engine
        VARCHAR host
        INTEGER port
        VARCHAR service_name
        VARCHAR username
        VARCHAR environment_type
        DATETIME created_at
        DATETIME updated_at
    }
    test_cases {
        INTEGER id PK
        INTEGER project_id FK
        VARCHAR name
        VARCHAR description
        TEXT sql_query
        VARCHAR expected_result
        VARCHAR validation_type
        DATETIME created_at
        DATETIME updated_at
    }
    test_suites {
        INTEGER id PK
        INTEGER project_id FK
        VARCHAR name
        VARCHAR description
        DATETIME created_at
        DATETIME updated_at
    }
    usage_events {
        INTEGER id PK
        VARCHAR event_type
        INTEGER project_id FK
        VARCHAR source
        VARCHAR detail
        DATETIME created_at
    }
    execution_history {
        INTEGER id PK
        INTEGER project_id FK
        INTEGER test_case_id FK
        INTEGER suite_id FK
        INTEGER connection_profile_id FK
        VARCHAR status
        DATETIME executed_at
        FLOAT duration_ms
        VARCHAR statement_type
        TEXT executed_sql
        VARCHAR validation_type
        VARCHAR expected_result
        TEXT actual_result
        INTEGER rowcount
        BOOLEAN rollback_applied
        TEXT rollback_error
        TEXT error_message
        VARCHAR trigger_source
        VARCHAR run_id
    }
    suite_test_case {
        INTEGER suite_id PK,FK
        INTEGER test_case_id PK,FK
    }
    projects ||--o{ connection_profiles : "project_id"
    projects ||--o{ test_cases : "project_id"
    projects ||--o{ test_suites : "project_id"
    projects |o--o{ usage_events : "project_id"
    projects ||--o{ execution_history : "project_id"
    test_cases |o--o{ execution_history : "test_case_id"
    test_suites |o--o{ execution_history : "suite_id"
    connection_profiles |o--o{ execution_history : "connection_profile_id"
    test_suites ||--o{ suite_test_case : "suite_id"
    test_cases ||--o{ suite_test_case : "test_case_id"
